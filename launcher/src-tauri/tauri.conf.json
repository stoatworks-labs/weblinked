{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebLinked Launcher",
  "version": "0.6.1",
  "identifier": "works.stoat.weblinked.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WebLinked Launcher",
        "width": 460,
        "height": 500,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "launcher.toml",
      "resources/*"
    ],
    "linux": {
      "rpm": {
        "compression": {
          "type": "none"
        }
      }
    }
  }
}
