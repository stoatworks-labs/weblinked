<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>@WEBLINKED_HELPER_NAME@</string>
  <key>CFBundleExecutable</key>
  <string>@WEBLINKED_HELPER_NAME@</string>
  <key>CFBundleIdentifier</key>
  <string>@WEBLINKED_HELPER_BUNDLE_ID@</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>@WEBLINKED_HELPER_NAME@</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@WEBLINKED_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@WEBLINKED_VERSION@</string>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <!-- A helper must never show in the Dock or take focus: CEF launches several
       of them and each one appearing would be both ugly and disruptive. -->
  <key>LSUIElement</key>
  <true/>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
  </dict>
</dict>
</plist>
