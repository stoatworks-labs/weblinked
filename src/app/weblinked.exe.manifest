<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Declares the Windows versions WebLinked is written for. Without this Windows
  treats the process as a pre-Windows-10 application and lies to it about the
  OS version, and Chromium crashes on the lie. See the comment in
  CMakeLists.txt where this is embedded.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
